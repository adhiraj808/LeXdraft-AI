# Copy this file to .env and fill in real values before running docker-compose.
# Never commit the actual .env file.

# App
DEBUG=false
# Serve /docs and /redoc. Keep true for local dev; set false in production.
DOCS_ENABLED=true
# Hard cap for request bodies (bytes). 1 MB by default.
MAX_REQUEST_BYTES=1048576

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=changeme-generate-a-real-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Sign-In — same OAuth Client ID as frontend/.env's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# PostgreSQL
POSTGRES_DB=legal_draft_db
POSTGRES_USER=legaluser
POSTGRES_PASSWORD=changeme-use-a-real-password
# Local Docker Postgres needs none of these (empty = driver default). For AWS RDS
# set POSTGRES_SSLMODE=require (or verify-full with POSTGRES_SSLROOTCERT pointing
# at the RDS CA bundle) and POSTGRES_HOST to the RDS endpoint.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=
POSTGRES_SSLROOTCERT=

# Redis — use a strong password
REDIS_PASSWORD=changeme-use-a-real-redis-password
REDIS_HOST=localhost
REDIS_PORT=6379
# Set REDIS_ENABLED=false to run without a Redis server at all (in-process cache).
REDIS_ENABLED=true

# CORS — comma-separated list is not supported by pydantic-settings List[str] env parsing by default;
# set as a JSON array string, e.g. ALLOWED_ORIGINS=["http://localhost:5173"]
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Add your domain when deploying (e.g. api.example.com or *.example.com).
ALLOWED_HOSTS=["localhost","127.0.0.1","0.0.0.0","backend"]

# API Keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
HUGGINGFACE_TOKEN=your-huggingface-token
GOOGLE_CLIENT_SECRET=your-google-secret

# LLM providers (generic OpenAI-compatible endpoint)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
MODEL_PROVIDER=auto
